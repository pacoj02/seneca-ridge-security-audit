<mxCell id="e10" value="10" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52606D;strokeWidth=1.25;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;fontStyle=1;fontSize=12;" edge="1" parent="1" source="pay" target="paysaas"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="leg" value="Flows and protections" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#F5F7FA;strokeColor=#9AA5B1;fontColor=#1F2933;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1520" height="260" as="geometry"/></mxCell>
<mxCell id="f0" value="&lt;b&gt;1. Shipper to dispatcher: load tender by email&lt;/b&gt;&lt;br&gt;Data: load details, rates | Protected by: phone callback to a known number before booking" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1F2933;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="leg"><mxGeometry x="20" y="36" width="740" height="42" as="geometry"/></mxCell>
<mxCell id="f1" value="&lt;b&gt;2. Dispatcher to TMS: create and assign load&lt;/b&gt;&lt;br&gt;Data: load, driver, route | Protected by: single sign-on with MFA, TLS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1F2933;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="leg"><mxGeometry x="20" y="80" width="740" height="42" as="geometry"/></mxCell>
<mxCell id="f2" value="&lt;b&gt;3. TMS to driver app backend: load sync&lt;/b&gt;&lt;br&gt;Data: load details | Protected by: API key in Secrets Manager, TLS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1F2933;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="leg"><mxGeometry x="20" y="124" width="740" height="42" as="geometry"/></mxCell>
<mxCell id="f3" value="&lt;b&gt;4. Backend and driver phone&lt;/b&gt;&lt;br&gt;Data: load details down, BOL photos up | Protected by: MFA sign-in, TLS 1.2+, encrypted S3" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1F2933;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="leg"><mxGeometry x="20" y="168" width="740" height="42" as="geometry"/></mxCell>
<mxCell id="f4" value="&lt;b&gt;5. Driver at pickup&lt;/b&gt;&lt;br&gt;Data: driver identity, shipping papers | Protected by: pickup PIN checked by the shipper" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1F2933;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="leg"><mxGeometry x="20" y="212" width="740" height="42" as="geometry"/></mxCell>
<mxCell id="f5" value="&lt;b&gt;6. ELD unit to ELD platform&lt;/b&gt;&lt;br&gt;Data: GPS, hours of service | Protected by: vendor encryption, contract security terms" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1F2933;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="leg"><mxGeometry x="780" y="36" width="740" height="42" as="geometry"/></mxCell>
<mxCell id="f6" value="&lt;b&gt;7. ELD platform to TMS&lt;/b&gt;&lt;br&gt;Data: truck locations | Protected by: API over TLS, limited access to live tracking" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1F2933;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="leg"><mxGeometry x="780" y="80" width="740" height="42" as="geometry"/></mxCell>
<mxCell id="f7" value="&lt;b&gt;8. TMS to billing&lt;/b&gt;&lt;br&gt;Data: delivered loads, rates | Protected by: role-based access (billing role only)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1F2933;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="leg"><mxGeometry x="780" y="124" width="740" height="42" as="geometry"/></mxCell>
<mxCell id="f8" value="&lt;b&gt;9. Billing to shipper: invoice&lt;/b&gt;&lt;br&gt;Data: rates, amounts | Protected by: DMARC on the company email domain" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1F2933;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="leg"><mxGeometry x="780" y="168" width="740" height="42" as="geometry"/></mxCell>
<mxCell id="f9" value="&lt;b&gt;10. Payroll clerk to payroll SaaS&lt;/b&gt;&lt;br&gt;Data: driver pay, bank details | Protected by: MFA, bank changes verified by phone" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1F2933;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="leg"><mxGeometry x="780" y="212" width="740" height="42" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
</mxfile>
