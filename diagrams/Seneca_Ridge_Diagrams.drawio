<mxCell id="va2_0" value="File server with role-based shares" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="va2"><mxGeometry x="12" y="36" width="331" height="46" as="geometry"/></mxCell>
