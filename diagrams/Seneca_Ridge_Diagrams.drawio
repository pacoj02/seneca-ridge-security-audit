<mxCell id="rds" value="&lt;b&gt;Amazon RDS PostgreSQL, Multi-AZ&lt;/b&gt;&lt;br&gt;Encrypted with KMS (AES-256), daily backups" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2E8;strokeColor=#2E7D4F;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="iso"><mxGeometry x="20" y="30" width="440" height="64" as="geometry"/></mxCell>
<mxCell id="sg" value="Security groups: load balancer to app on 443 only; app to database on 5432 only.&lt;br&gt;The app reaches S3 and Secrets Manager through private VPC endpoints." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#52606D;strokeColor=none;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="vpc"><mxGeometry x="20" y="418" width="480" height="36" as="geometry"/></mxCell>
