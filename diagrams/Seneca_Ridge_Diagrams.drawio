<mxCell id="app" value="&lt;b&gt;App tier: ECS Fargate in both AZs&lt;/b&gt;&lt;br&gt;Driver API and office portal, no public IPs" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="priv"><mxGeometry x="20" y="30" width="440" height="64" as="geometry"/></mxCell>
