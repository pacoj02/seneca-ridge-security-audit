<mxCell id="va3_0" value="Wazuh SIEM: logs, alerts, FIM" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2E8;strokeColor=#2E7D4F;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="va3"><mxGeometry x="12" y="36" width="331" height="46" as="geometry"/></mxCell>
<mxCell id="va3_1" value="Admin jump box with MFA" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="va3"><mxGeometry x="12" y="92" width="331" height="46" as="geometry"/></mxCell>
<mxCell id="va3_2" value="Only zone allowed to use admin ports" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="va3"><mxGeometry x="12" y="148" width="331" height="46" as="geometry"/></mxCell>
<mxCell id="vb0" value="VLAN 40: Shop (10.10.40.0/24)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#2B6CB0;strokeWidth=1.25;fontColor=#1F2933;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="lan"><mxGeometry x="20" y="280" width="480" height="110" as="geometry"/></mxCell>
<mxCell id="vb0_0" value="&lt;b&gt;Shop PCs&lt;/b&gt;&lt;br&gt;Maintenance software, EDR, patching" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="vb0"><mxGeometry x="12" y="38" width="456" height="60" as="geometry"/></mxCell>
<mxCell id="vb1" value="VLAN 50: Cameras (10.10.50.0/24)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#2B6CB0;strokeWidth=1.25;fontColor=#1F2933;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="lan"><mxGeometry x="520" y="280" width="480" height="110" as="geometry"/></mxCell>
<mxCell id="vb1_0" value="&lt;b&gt;IP cameras and NVR&lt;/b&gt;&lt;br&gt;New passwords, current firmware, no internet" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="vb1"><mxGeometry x="12" y="38" width="456" height="60" as="geometry"/></mxCell>
<mxCell id="vb2" value="VLAN 60: Guest Wi-Fi (10.10.60.0/24)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#2B6CB0;strokeWidth=1.25;fontColor=#1F2933;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="lan"><mxGeometry x="1020" y="280" width="480" height="110" as="geometry"/></mxCell>
<mxCell id="vb2_0" value="&lt;b&gt;Driver lounge and visitors&lt;/b&gt;&lt;br&gt;Internet only, clients isolated from each other" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="vb2"><mxGeometry x="12" y="38" width="456" height="60" as="geometry"/></mxCell>
<mxCell id="rules" value="Key firewall rules" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#F5F7FA;strokeColor=#9AA5B1;fontColor=#1F2933;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1520" height="96" as="geometry"/></mxCell>
<mxCell id="r1" value="1. Guest Wi-Fi (60): internet only, blocked from every internal VLAN&lt;br&gt;2. Cameras (50): reach the NVR only, no internet&lt;br&gt;3. Office (10) and Dispatch (20): reach Servers (30) on file sharing ports only" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1F2933;strokeColor=none;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="rules"><mxGeometry x="20" y="28" width="720" height="62" as="geometry"/></mxCell>
<mxCell id="r2" value="4. Admin ports (SSH, RDP) open only from Management (99)&lt;br&gt;5. Every VLAN sends logs to Wazuh (99) on ports 1514 and 1515&lt;br&gt;6. Everything else is denied, and every deny is logged" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1F2933;strokeColor=none;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="rules"><mxGeometry x="760" y="28" width="740" height="62" as="geometry"/></mxCell>
